# ==============================
# Node Backend Settings
# ==============================
# If using docker-compose MongoDB container: mongodb://mongodb:27017/getplaced
# Or specify your remote MongoDB Atlas URI:
MONGO_URI=mongodb://mongodb:27017/getplaced
JWT_SECRET=your_super_secret_jwt_key
PORT=3000
NODE_ENV=production
GEMINI_MODEL_TIMEOUT_MS=10000
GEMINI_RESPONSE_BUDGET_MS=45000

# ==============================
# Python Backend Settings
# ==============================
GOOGLE_API_KEY=your_gemini_api_key
# Python resume analysis: one bounded Gemini attempt before deterministic fallback.
PY_GEMINI_REQUEST_TIMEOUT_MS=20000
RAPIDAPI_KEY=your_rapidapi_key
ADZUNA_API_ID=your_adzuna_api_id
ADZUNA_API_KEY=your_adzuna_api_key

# ==============================
# Frontend Settings (Build Time)
# ==============================
VITE_NODE_API_URL=http://localhost:3000
VITE_PY_API_URL=http://localhost:8000
